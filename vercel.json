{
  "framework": "nextjs",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/chat/**": {
      "maxDuration": 60
    },
    "src/app/api/study-friend/**": {
      "maxDuration": 60
    },
    "src/app/api/summarize/**": {
      "maxDuration": 60
    },
    "src/app/api/plagiarism/**": {
      "maxDuration": 120
    },
    "src/app/api/recommendations/**": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
