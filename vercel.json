{
  "framework": "nextjs",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/chat/**": {
      "maxDuration": 60
    },
    "src/app/api/study-friend/**": {
      "maxDuration": 60
    },
    "src/app/api/summarize/**": {
      "maxDuration": 60
    },
    "src/app/api/plagiarism/**": {
      "maxDuration": 60
    },
    "src/app/api/recommendations/**": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/inactivity-reminder",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/live-class-reminders",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
