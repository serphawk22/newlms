generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}


enum EnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
}

model Organization {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  joinCode       String               @unique
  instructorCode String               @unique
  adminCode      String               @unique
  courses        Course[]
  dailyBites     DailyBite[]
  members        OrganizationMember[]

  @@index([name])
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  password                 String
  name                     String?
  status                   UserStatus               @default(PENDING)
  avatar                   String?
  coverImage               String?
  loginCode                String?                  @unique
  sessionToken             String?
  expertise                String[]                 @default([])
  bio                      String?
  lastLoginAt              DateTime?
  lastReminderSentAt       DateTime?
  adminCommentsAuthored    AdminComment[]           @relation("AdminCommentAuthor")
  adminCommentsReceived    AdminComment[]           @relation("AdminCommentStudent")
  submissions              AssignmentSubmission[]
  chats                    Chat[]
  coursesCreated           Course[]                 @relation("CourseCreator")
  enrollments              Enrollment[]
  materialViews            MaterialView[]
  notifications            Notification[]
  memberships              OrganizationMember[]
  quizSubmissions          QuizSubmission[]
  recordedClasses          RecordedClass[]
  reviews                  Review[]
  studentRoadmapProgresses StudentRoadmapProgress[]
  dailyLogins              DailyLogin[]
  certificates             Certificate[]
  studyFriendSessions      StudyFriendSession[]
  courseComments           CourseComment[]          @relation("CourseCommentAuthor")
  userBadges               UserBadge[]
  adminReviewVideos        AdminReviewVideo[]
  emailNotifications       EmailNotification[]
}

model EmailNotification {
  id           String    @id @default(cuid())
  userId       String?
  toEmail      String
  subject      String
  type         String    // "LOGIN" | "COURSE_CREATE" | "ASSIGNMENT" | "QUIZ" | "FEEDBACK" | "COURSE_UPDATE" | "INACTIVITY"
  html         String?   @db.Text
  status       String    @default("PENDING") // PENDING | SENT | FAILED
  retryCount   Int       @default(0)
  errorMessage String?   @db.Text
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(STUDENT)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Course {
  id               String            @id @default(cuid())
  title            String
  description      String?
  published        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organizationId   String
  creatorId        String
  adminComments    AdminComment[]
  assignments      Assignment[]
  chats            Chat[]
  creator          User              @relation("CourseCreator", fields: [creatorId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseRoadmap    CourseRoadmap?
  enrollments      Enrollment[]
  events           Event[]
  liveSessions     LiveSession[]
  modules          Module[]
  quizzes          Quiz[]
  readingMaterials ReadingMaterial[]
  recordedClasses  RecordedClass[]
  certificates     Certificate[]
  reviews          Review[]
  courseComments   CourseComment[]
  courseActivities CourseActivity[]
  adminReviewVideos AdminReviewVideo[]
  joinQuestions    Json?

  @@index([organizationId])
  @@index([creatorId])
  @@index([published])
}

model Module {
  id              String          @id @default(cuid())
  title           String
  courseId        String
  lessons           Lesson[]
  liveSessions      LiveSession[]
  course            Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  recordedClasses   RecordedClass[]
  adminReviewVideos AdminReviewVideo[]

  @@index([courseId])
}

model Lesson {
  id        String  @id @default(cuid())
  title     String
  videoUrl  String?
  driveLink String?
  moduleId  String
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  adminReviewVideos AdminReviewVideo[]

  @@index([moduleId])
}

model AdminReviewVideo {
  id           String   @id @default(cuid())
  courseId     String
  moduleId     String
  lessonId     String
  instructorId String
  videoUrl     String
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  uploadedAt   DateTime @default(now())

  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  instructor   User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([moduleId])
  @@index([lessonId])
  @@index([instructorId])
}

model Enrollment {
  id         String           @id @default(cuid())
  userId     String
  courseId   String
  status     EnrollmentStatus @default(PENDING)
  progress   Float            @default(0.0)
  enrolledAt DateTime         @default(now())
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinAnswers        Json?
  joinScore          Int?
  joinTotalQuestions Int?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model DailyBite {
  id             String       @id @default(cuid())
  title          String
  videoUrl       String
  date           DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Assignment {
  id                String                 @id @default(cuid())
  title             String
  description       String?
  driveLink         String?
  courseId          String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  course            Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions       AssignmentSubmission[]
  plagiarismResults PlagiarismResult[]

  @@index([courseId])
}

model AssignmentSubmission {
  id               String            @id @default(cuid())
  assignmentId     String
  studentId        String
  driveLink        String            @default("")
  fileUrl          String?
  publicId         String?
  fileType         String?
  mimeType         String?
  fileSize         Int?
  originalFileName String?
  fileId           String?
  grade            Int?
  maxGrade         Int               @default(100)
  feedback         String?
  submittedAt      DateTime          @default(now())
  gradedAt         DateTime?
  assignment       Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  file             UploadedFile?     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  student          User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plagiarismResult PlagiarismResult?

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

model ReadingMaterial {
  id               String         @id @default(cuid())
  title            String
  link             String?
  courseId         String
  fileUrl          String?
  originalFileName String?
  publicId         String?
  fileType         String?
  mimeType         String?
  resourceType     String?
  fileSize         Int?
  uploadedBy       String?
  fileId           String?
  createdAt        DateTime       @default(now())
  materialViews    MaterialView[]
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  file             UploadedFile?  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Quiz {
  id           String           @id @default(cuid())
  title        String
  courseId     String
  retryEnabled Boolean          @default(false)
  createdAt    DateTime         @default(now())
  questions    Question[]
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions  QuizSubmission[]

  @@index([courseId])
}

model QuizSubmission {
  id            String   @id @default(cuid())
  quizId        String
  studentId     String
  answers       Json
  obtainedMarks Int
  totalMarks    Int
  submittedAt   DateTime @default(now())
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([quizId])
  @@index([studentId])
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  type          String
  text          String
  options       String[]
  correctOption Int?
  points        Int      @default(1)
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id       String   @id @default(cuid())
  title    String
  date     DateTime
  type     String
  courseId String?
  course   Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model PlagiarismResult {
  id               String               @id @default(cuid())
  submissionId     String               @unique
  assignmentId     String
  status           String               @default("PENDING")
  similarityScore  Float                @default(0)
  plagiarismStatus String               @default("SAFE")
  matches          Json                 @default("[]")
  extractedText    String?
  errorMessage     String?
  checkedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  assignment       Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submission       AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([submissionId])
}

model LiveSession {
  id           String            @id @default(cuid())
  roomId       String            @unique
  title        String
  courseId     String
  moduleId     String?
  status       LiveSessionStatus @default(SCHEDULED)
  scheduledAt  DateTime          @default(now())
  recordingUrl String?
  createdAt    DateTime          @default(now())
  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module       Module?           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([moduleId])
}

model Chat {
  id        String        @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
  @@index([courseId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  courseId  String
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
}

model RecordedClass {
  id           String   @id @default(cuid())
  courseId     String
  instructorId String
  title        String
  videoUrl     String
  duration     Int?
  moduleId     String?
  createdAt    DateTime @default(now())
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  module       Module?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([instructorId])
  @@index([moduleId])
}

model MaterialView {
  id         String          @id @default(cuid())
  materialId String
  studentId  String
  viewedAt   DateTime        @default(now())
  viewCount  Int             @default(1)
  material   ReadingMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student    User            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([materialId, studentId])
  @@index([materialId])
  @@index([studentId])
}

model UploadedFile {
  id                    String                 @id @default(cuid())
  originalName          String
  extension             String
  mimeType              String
  size                  Int
  url                   String
  publicId              String
  resourceType          String?
  uploadedBy            String?
  uploadedAt            DateTime               @default(now())
  assignmentSubmissions AssignmentSubmission[]
  readingMaterials      ReadingMaterial[]

  @@index([uploadedAt])
  @@index([uploadedBy])
}

model AdminComment {
  id         String   @id @default(cuid())
  content    String
  courseId   String
  authorId   String
  targetType String
  studentId  String?
  createdAt  DateTime @default(now())
  author     User     @relation("AdminCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    User?    @relation("AdminCommentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([authorId])
  @@index([studentId])
}

model StudyFriendSession {
  id            String               @id @default(cuid())
  userId        String
  title         String
  fileUrl       String?
  fileName      String?
  fileExt       String?
  extractedText String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  messages      StudyFriendMessage[]
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudyFriendMessage {
  id        String             @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime           @default(now())
  session   StudyFriendSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model PromptCache {
  id         String   @id @default(cuid())
  promptHash String   @unique
  prompt     String
  response   String
  createdAt  DateTime @default(now())

  @@index([promptHash])
}

model CourseRoadmap {
  id        String         @id @default(cuid())
  courseId  String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  phases    RoadmapPhase[]
}

model RoadmapPhase {
  id          String         @id @default(cuid())
  roadmapId   String
  title       String
  description String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  roadmap     CourseRoadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics      RoadmapTopic[]

  @@index([roadmapId])
}

model RoadmapTopic {
  id        String            @id @default(cuid())
  phaseId   String
  title     String
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  subtopics RoadmapSubtopic[]
  phase     RoadmapPhase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
}

model RoadmapSubtopic {
  id        String                   @id @default(cuid())
  topicId   String
  title     String
  order     Int                      @default(0)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  topic     RoadmapTopic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress  StudentRoadmapProgress[]

  @@index([topicId])
}

model StudentRoadmapProgress {
  id          String          @id @default(cuid())
  studentId   String
  subtopicId  String
  completedAt DateTime        @default(now())
  student     User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subtopic    RoadmapSubtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)

  @@unique([studentId, subtopicId])
  @@index([studentId])
  @@index([subtopicId])
}

model SharedVideo {
  id          String   @id @default(cuid())
  studentName String
  email       String
  videoUrl    String
  caption     String?
  orgId       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([orgId])
}

// ── Daily Login Tracking (for Learning Streak) ────────────────────────────────

model DailyLogin {
  id        String   @id @default(cuid())
  userId    String
  dateStr   String   // format: "YYYY-MM-DD"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateStr])
  @@index([userId])
}

// ── Certificates ──────────────────────────────────────────────────────────────

model Certificate {
  id                String   @id @default(cuid())
  studentId         String
  courseId          String
  certificateNumber String   @unique
  completionDate    DateTime @default(now())
  courseDuration    String
  certificateUrl    String?
  verificationToken String   @unique
  status            String   @default("ELIGIBLE") // ELIGIBLE | ISSUED | DENIED
  createdAt         DateTime @default(now())

  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([certificateNumber])
}

model CertificateTemplate {
  id        String   @id @default(cuid())
  name      String
  fileUrl   String
  isActive  Boolean  @default(false)
  mappings  Json?    // Stores field positions as percentages: { studentName: {x,y,w,h,fontSize,color,align}, ... }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LiveSessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
}

model CourseComment {
  id        String   @id @default(cuid())
  content   String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CourseCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    CourseComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CourseComment[] @relation("CommentReplies")
  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([authorId])
  @@index([parentId])
}

// ── User Badges (persisted achievement unlock state) ──────────────────────────

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeName  String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeName])
  @@index([userId])
}

model CourseActivity {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  action    String
  timestamp DateTime @default(now())

  @@index([courseId])
}
